# ==============================================================================
# Smart Campus Analytics - Production Environment Configuration Template
# Copy this file to '.env' and populate with production credentials.
# NEVER commit the real '.env' file containing secrets to version control.
# ==============================================================================

# Core Application Settings
SECRET_KEY=generate-a-strong-random-50-plus-character-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us
LOG_LEVEL=INFO

# Institutional Student Access
ALLOW_PUBLIC_STUDENT_REGISTRATION=False

# Database Configuration (PostgreSQL in production, SQLite for local testing)
# Example PostgreSQL: postgres://user:password@localhost:5432/smart_campus_db
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=False

# Email Alert & Advisory Configuration
# Use 'django.core.mail.backends.smtp.EmailBackend' for production SMTP delivery.
# Use 'django.core.mail.backends.console.EmailBackend' for local terminal logging.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Smart Campus Analytics <alerts@yourdomain.com>
SERVER_EMAIL=Smart Campus Server <server@yourdomain.com>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@yourdomain.com
EMAIL_HOST_PASSWORD=your-secure-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Security & SSL Settings (Set to True when deployed behind HTTPS / Reverse Proxy)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_X_FORWARDED_HOST=True

# File & Request Payload Limits (in bytes, default 5 MB)
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880

# REST API Throttling Limits
API_ANON_RATE=60/hour
API_USER_RATE=600/hour
